{
  "version": 1,
  "description": "The single sensitive-path list. AGENTS.md mirrors it between the sensitive-paths markers (checked by scripts/validate-agent-contract.mjs; regenerate with npm run sensitive-paths:render). Consumers import scripts/lib/sensitive-paths.mjs and never copy these globs. Globs use picomatch semantics with dot and nocase on; supported syntax is *, **, ? and {a,b}. Adding a glob or class is free; removing, narrowing or reclassifying one is gate_loosening.",
  "classes": {
    "schema": { "label": "Database schema", "description": "SQL files, schema drafts and database config" },
    "migrations": { "label": "Migrations", "description": "database migration directories" },
    "auth": { "label": "Auth, permissions, sessions", "description": "authentication, authorization, row-level security, permission and session paths" },
    "payments": { "label": "Payments, pricing, billing", "description": "payment, billing, pricing, invoice, subscription and checkout paths" },
    "integrations": { "label": "External integrations", "description": "code that sends data to, or acts on, third-party providers, webhooks and outbound dispatch" },
    "secrets": { "label": "Secrets and env", "description": "secrets, credentials, keys, tokens, vaults and env files" },
    "infra_ci": { "label": "Infra, CI, deploy, governance", "description": "workflows, infrastructure, containers, hosting config, deploy and release scripts, and the files that define and apply the gates (this list, AGENTS.md, pstack.config.json, the matcher, review gate, journey check, preflight and template sync)" },
    "deps": { "label": "Dependencies", "description": "package manifests and lockfiles" }
  },
  "globs": [
    { "glob": "**/*.sql", "class": "schema" },
    { "glob": "**/schema.prisma", "class": "schema" },
    { "glob": "**/{schema,schemas}/**/*.{sql,prisma,graphql}", "class": "schema" },
    { "glob": "supabase/config.toml", "class": "schema" },

    { "glob": "**/migrations/**", "class": "migrations" },
    { "glob": "**/migrate/**", "class": "migrations" },

    { "glob": "**/*auth*{,/**}", "class": "auth" },
    { "glob": "**/{rls,*-rls,*_rls}*{,/**}", "class": "auth" },
    { "glob": "**/*permission*{,/**}", "class": "auth" },
    { "glob": "**/*session*{,/**}", "class": "auth" },
    { "glob": "**/middleware.{ts,js,mjs}", "class": "auth" },

    { "glob": "**/*payment*{,/**}", "class": "payments" },
    { "glob": "**/*billing*{,/**}", "class": "payments" },
    { "glob": "**/*stripe*{,/**}", "class": "payments" },
    { "glob": "**/*pricing*{,/**}", "class": "payments" },
    { "glob": "**/*invoice*{,/**}", "class": "payments" },
    { "glob": "**/*checkout*{,/**}", "class": "payments" },
    { "glob": "**/*subscription*{,/**}", "class": "payments" },

    { "glob": "**/*dispatch*{,/**}", "class": "integrations" },
    { "glob": "**/*webhook*{,/**}", "class": "integrations" },
    { "glob": "**/{adapters,integrations,providers}/**", "class": "integrations" },

    { "glob": "**/*secret*{,/**}", "class": "secrets" },
    { "glob": "**/*credential*{,/**}", "class": "secrets" },
    { "glob": "**/*.pem", "class": "secrets" },
    { "glob": "**/*.key", "class": "secrets" },
    { "glob": "**/*.p12", "class": "secrets" },
    { "glob": "**/keys/**", "class": "secrets" },
    { "glob": "**/token{,s}.{json,yaml,yml,ts,js}", "class": "secrets" },
    { "glob": "**/*vault*{,/**}", "class": "secrets" },
    { "glob": "**/.env*", "class": "secrets" },
    { "glob": "**/env.{ts,js,json}", "class": "secrets" },

    { "glob": ".github/workflows/**", "class": "infra_ci" },
    { "glob": ".github/actions/**", "class": "infra_ci" },
    { "glob": ".github/CODEOWNERS", "class": "infra_ci" },
    { "glob": "**/{infra,terraform,deploy,k8s,helm,ops}/**", "class": "infra_ci" },
    { "glob": "**/*.tf", "class": "infra_ci" },
    { "glob": "**/Dockerfile*", "class": "infra_ci" },
    { "glob": "**/docker-compose*", "class": "infra_ci" },
    { "glob": "**/{vercel.json,netlify.toml,fly.toml}", "class": "infra_ci" },
    { "glob": "scripts/deploy*{,/**}", "class": "infra_ci" },
    { "glob": "scripts/release*{,/**}", "class": "infra_ci" },
    { "glob": "docs/sensitive-paths.json", "class": "infra_ci" },
    { "glob": "AGENTS.md", "class": "infra_ci" },
    { "glob": "CLAUDE.md", "class": "infra_ci" },
    { "glob": "pstack.config.json", "class": "infra_ci" },
    { "glob": ".pstack-template-version", "class": "infra_ci" },
    { "glob": "scripts/lib/**", "class": "infra_ci" },
    { "glob": "scripts/sensitive-paths*", "class": "infra_ci" },
    { "glob": "scripts/fixtures/sensitive-paths/**", "class": "infra_ci" },
    { "glob": "scripts/review-gate*", "class": "infra_ci" },
    { "glob": "scripts/jev-client*", "class": "infra_ci" },
    { "glob": "scripts/check-journey-tests*", "class": "infra_ci" },
    { "glob": "scripts/check-pr-body*", "class": "infra_ci" },
    { "glob": "scripts/validate-agent-contract*", "class": "infra_ci" },
    { "glob": "scripts/preflight*", "class": "infra_ci" },
    { "glob": "scripts/sync-template*", "class": "infra_ci" },

    { "glob": "**/package.json", "class": "deps" },
    { "glob": "**/{package-lock.json,npm-shrinkwrap.json,yarn.lock,pnpm-lock.yaml,bun.lockb,deno.lock}", "class": "deps" },
    { "glob": "**/requirements*.txt", "class": "deps" },
    { "glob": "**/{pyproject.toml,uv.lock,poetry.lock,Pipfile,Pipfile.lock}", "class": "deps" },
    { "glob": "**/{Cargo.toml,Cargo.lock,go.mod,go.sum,Gemfile,Gemfile.lock}", "class": "deps" }
  ]
}
