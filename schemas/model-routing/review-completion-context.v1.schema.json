{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pstack:model-routing:review-completion-context:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "model-routing.review-completion-context.v1"
    },
    "expected": {
      "type": "object",
      "properties": {
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diffDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalogDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repoId",
        "baseSha",
        "headSha",
        "artifactDigest",
        "diffDigest",
        "policyDigest",
        "catalogDigest",
        "contextDigest",
        "planDigest"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receiptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "receiptDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
          },
          "executionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "identity": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "effort": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              }
            },
            "required": [
              "provider",
              "model",
              "family",
              "effort"
            ],
            "additionalProperties": false
          },
          "resultDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "receiptId",
          "receiptDigest",
          "issuer",
          "reference",
          "observedAt",
          "expiresAt",
          "executionId",
          "identity",
          "resultDigest"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "usedReceiptIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "usedResultDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "ceiling": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "wallTimeMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tokens",
            "wallTimeMs",
            "attempts"
          ],
          "additionalProperties": false
        },
        "consumed": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "wallTimeMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tokens",
            "wallTimeMs",
            "attempts"
          ],
          "additionalProperties": false
        },
        "repairRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noProgress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "similarFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        }
      },
      "required": [
        "ceiling",
        "consumed",
        "repairRounds",
        "noProgress",
        "similarFailures",
        "deadline",
        "evidenceRef"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxRepairRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "maxNoProgress": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "maxSimilarFailures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "maxRepairRounds",
        "maxNoProgress",
        "maxSimilarFailures"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "expected",
    "observations",
    "usedReceiptIds",
    "usedResultDigests",
    "budget",
    "limits"
  ],
  "additionalProperties": false
}
