{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pstack:model-routing:policy:v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "model-routing.policy.v2"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "repoId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "reviewPolicyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalogDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "billing": {
      "const": "subscription_included"
    },
    "maxEvidenceAgeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "entryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "effort": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "explicit"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "intent"
                  },
                  "mappingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  }
                },
                "required": [
                  "kind",
                  "mappingId",
                  "intent"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "omit"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          },
          "reservation": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "wallTimeMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "tokens",
              "wallTimeMs",
              "attempts"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "entryId",
          "effort",
          "requiredCapabilities",
          "reservation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "risk": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "allowOmission": {
            "type": "boolean"
          },
          "approvedMappings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "role",
          "risk",
          "candidates",
          "allowOmission",
          "approvedMappings"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "overrideEnvelope": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "enabled",
        "profiles"
      ],
      "additionalProperties": false
    },
    "maxRepairRounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "maxNoProgress": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "maxSimilarFailures": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "reviewRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "independent": {
                  "const": true
                },
                "crossFamily": {
                  "type": "boolean"
                },
                "binding": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "named"
                        },
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                        },
                        "family": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                        },
                        "explicitEffort": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                        },
                        "profiles": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                          },
                          "minItems": 1,
                          "maxItems": 128,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "kind",
                        "provider",
                        "model",
                        "family",
                        "explicitEffort",
                        "profiles"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "capability"
                        },
                        "capability": {
                          "enum": [
                            "correctness",
                            "deep"
                          ]
                        },
                        "coverage": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                          },
                          "minItems": 1,
                          "maxItems": 128,
                          "uniqueItems": true
                        },
                        "primaryProfiles": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                          },
                          "minItems": 1,
                          "maxItems": 128,
                          "uniqueItems": true
                        },
                        "fallbackProfiles": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                          },
                          "minItems": 0,
                          "maxItems": 128,
                          "uniqueItems": true
                        },
                        "fallbackWhen": {
                          "const": "confirmed_unavailable"
                        }
                      },
                      "required": [
                        "kind",
                        "capability",
                        "coverage",
                        "primaryProfiles",
                        "fallbackProfiles",
                        "fallbackWhen"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "independent",
                "crossFamily",
                "binding"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "risk",
          "slots"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "revision",
    "projectId",
    "repoId",
    "reviewPolicyDigest",
    "catalogDigest",
    "issuedAt",
    "expiresAt",
    "billing",
    "maxEvidenceAgeSeconds",
    "allowedActions",
    "profiles",
    "rules",
    "overrideEnvelope",
    "maxRepairRounds",
    "maxNoProgress",
    "maxSimilarFailures",
    "reviewRules"
  ],
  "additionalProperties": false
}
